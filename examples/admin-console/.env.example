RBS_ENV=development
RBS_DATABASE__URL=postgres://postgres:postgres@localhost:5432/admin_console

# Le service `db` de docker-compose.yml interpole ces clés depuis `.env`, qui n'est pas
# versionné : ce sont les identifiants de l'URL ci-dessus, à remplacer par les vôtres.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=admin_console

# Délai au terme duquel une requête est abandonnée, en secondes. `config/default.toml`
# porte la même clé ; décommenter celle-ci la remplace sans toucher au fichier versionné.
# RBS_SERVER__TIMEOUT_SECS=30

RBS_LOG_FORMAT=pretty
RUST_LOG=info,admin_console=debug

# Mot de passe du compte SMTP. Reste vide tant que `smtp_user` l'est.
RBS_MAIL__SMTP_PASSWORD=

# Secret de signature HS256. 32 octets au moins, sans quoi le démarrage échoue.
RBS_AUTH__SECRET=changez-moi-par-un-secret-tire-au-hasard-de-32-octets-au-moins

# Le compte d'administration que `rbs seed` pose dans la table des comptes
ADMIN_EMAIL=admin@example.com

# Son mot de passe, tiré au hasard dans le .env — l'exemple versionné n'en porte qu'un repère
ADMIN_PASSWORD=changez-moi-ce-mot-de-passe-est-publie-dans-git
