RBS_ENV=development
RBS_DATABASE__URL=postgres://postgres:postgres@localhost:5432/file_drop

RBS_LOG_FORMAT=pretty
RUST_LOG=info,file_drop=debug

# Mot de passe du compte SMTP. Reste vide tant que `smtp_user` l'est.
RBS_MAIL__SMTP_PASSWORD=

# Backend `s3` : sans effet tant que storage.backend vaut "fs".
RBS_STORAGE__BUCKET=demo

RBS_STORAGE__ACCESS_KEY_ID=changez-moi

RBS_STORAGE__SECRET_ACCESS_KEY=changez-moi
