RBS_ENV=development
RBS_DATABASE__URL=postgres://rbs:rbs@localhost:5432/event_hub

# Le service `db` de docker-compose.yml interpole ces clés depuis ce fichier : le compose
# est versionné, celui-ci est ignoré par git.
POSTGRES_USER=rbs
POSTGRES_PASSWORD=rbs
POSTGRES_DB=event_hub

RBS_LOG_FORMAT=pretty
RUST_LOG=info,event_hub=debug

# Secret de signature HS256. 32 octets au moins, sans quoi le démarrage échoue.
RBS_AUTH__SECRET=ce82adf8ce99faa64c1531010e94cb813c2b3c6fe9658849fd110ac098cda00a
