/* L'entrée de la feuille de style du client.
 *
 * Volontairement pauvre : elle donne au socle de quoi être lisible, pas son monde visuel.
 * Les variables ci-dessous sont celles de la page d'amorçage que sert le binaire, pour que
 * la seconde page ne dépayse pas après la première — le reste est du style d'élément
 * ordinaire, qu'un thème remplacera.
 */
:root {
  color-scheme: light;
  --papier: #f2efe6;
  --bande: #e9e5d8;
  --encre: #1b1a17;
  --pale: #6f6a5e;
  --filet: #cbc5b4;
  --alerte: #a8322a;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--papier);
  color: var(--encre);
  font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono',
    monospace;
  font-size: 15px;
  line-height: 1.6;
}

.feuille {
  max-width: 62rem;
  margin: 0 auto;
  border-left: 1px solid var(--filet);
  border-right: 1px solid var(--filet);
}

.bande {
  padding: 2rem 1.5rem;
  border-bottom: 1px solid var(--filet);
}

.bande:last-child {
  border-bottom: 0;
}

.bande--paire {
  background: var(--bande);
}

.projet {
  margin: 0 0 1.5rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--pale);
}

h1 {
  margin: 0 0 1rem;
  font-size: 2rem;
  line-height: 1.2;
}

h2 {
  margin: 0 0 1.25rem;
  font-size: 1rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--pale);
}

p {
  margin: 0;
}

.tenue {
  color: var(--pale);
}

.releve {
  display: grid;
  grid-template-columns: minmax(10rem, auto) 1fr;
  gap: 0.35rem 1.5rem;
  margin: 0;
}

dt {
  color: var(--pale);
}

dd {
  margin: 0;
}

/* Le verdict passe par une classe et non par un mot de couleur écrit dans le balisage :
 * une autre palette se pose alors en réécrivant les seules variables. */
dd.manque {
  color: var(--alerte);
}

code {
  padding: 0.1rem 0.4rem;
  border: 1px solid var(--filet);
  background: var(--papier);
}
