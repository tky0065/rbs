@import 'tailwindcss';
@import 'tw-animate-css';
@import 'vue-sonner/style.css';

/* La police, tirée du registre de paquets.
 *
 * Un fragment ne livre que de l'UTF-8 : un `.woff2` n'en sortirait pas, et la police ne
 * peut donc pas vivre dans les templates. Deux graisses — le corps et les titres — sur
 * les deux sous-ensembles que les textes français et anglais demandent ; `latin-ext`
 * porte l'« œ » et les guillemets que `latin` n'a pas.
 *
 * Elle ne fait qu'arriver devant la pile système de `--font-sans` : tant que
 * `npm install` n'a pas eu lieu, ou si ce paquet s'en va, la page se lit dans la chasse
 * de la machine — celle que sert déjà la page d'amorçage, qui ne joint aucun registre. */
@import '@fontsource/ibm-plex-mono/latin-400.css';
@import '@fontsource/ibm-plex-mono/latin-700.css';
@import '@fontsource/ibm-plex-mono/latin-ext-400.css';
@import '@fontsource/ibm-plex-mono/latin-ext-700.css';

/* La variante sombre, accrochée à une classe que rien ne porte — et c'est une extinction,
 * pas une préparation.
 *
 * Les composants livrés portent les classes `dark:` que shadcn-vue leur donne. Laissées à
 * la variante par défaut, elles répondent à la préférence du système : sur une machine
 * réglée en sombre, `dark:bg-input/30` et ses voisines s'appliqueraient par-dessus une
 * palette qui n'a, elle, qu'un seul jeu de valeurs — un champ assombri sur du papier
 * clair. Les accrocher ici les éteint sans toucher à un composant, ni empêcher qui
 * voudra d'un second jeu de valeurs de les rallumer. */
@custom-variant dark (&:where(.sombre, .sombre *));

/* Le monde visuel du projet, en entier.
 *
 * Sept couleurs, les mêmes que celles de la page d'amorçage que sert le binaire, pour que
 * la seconde page ne dépayse pas après la première. Une sortie d'imprimante ligne : papier
 * en continu, bandes pleine largeur, encre de ruban d'impact, et une seule seconde couleur
 * pour l'alerte.
 *
 * Remplacer ce bloc remplace l'identité. Aucun composant ne nomme une couleur : ils ne
 * connaissent que les rôles ci-dessous. */
@theme {
  /* Le papier, et l'encre qui s'y dépose. */
  --color-background: #f2efe6;
  --color-foreground: #1b1a17;

  /* Le creux — une fenêtre non imprimée, d'où sort ce qui se détache de la page. */
  --color-card: #f7f5ee;
  --color-card-foreground: #1b1a17;
  --color-popover: #f7f5ee;
  --color-popover-foreground: #1b1a17;

  /* L'encre pleine : ce sur quoi le regard tombe en premier. */
  --color-primary: #1b1a17;
  --color-primary-foreground: #f2efe6;

  /* La bande, matériau des aplats de second rang. */
  --color-secondary: #e9e5d8;
  --color-secondary-foreground: #1b1a17;
  --color-muted: #e9e5d8;
  --color-muted-foreground: #6f6a5e;

  /* Le filet, pour ce que le curseur touche : une bande pressée sous le ruban. */
  --color-accent: #cbc5b4;
  --color-accent-foreground: #1b1a17;

  /* Les traits, et le halo du focus. */
  --color-border: #cbc5b4;
  --color-input: #cbc5b4;
  --color-ring: #6f6a5e;

  /* La seconde couleur, et la seule. */
  --color-destructive: #a8322a;

  /* Rien n'est arrondi : une imprimante ligne ne sait pas tracer de courbe. Les quatre
   * échelons sont à zéro plutôt que supprimés, pour que `rounded-md` reste écrivable dans
   * un composant sans lui rendre un angle que le monde n'a pas. */
  --radius: 0px;
  --radius-sm: 0px;
  --radius-md: 0px;
  --radius-lg: 0px;
  --radius-xl: 0px;

  /* Une seule chasse : tout est sorti de la même machine. Le repli est la pile système,
   * mot pour mot celle de la page d'amorçage. */
  --font-sans:
    'IBM Plex Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas,
    'Liberation Mono', monospace;
  --font-mono: var(--font-sans);

  /* L'impression d'une ligne : le ruban la découvre de gauche à droite, par pas, comme
   * une tête qui frappe — et non d'un glissement continu. Ce que `motion-safe:` pose,
   * une préférence de mouvement réduit ne pose pas. */
  --animate-impression: impression 260ms steps(14, end);

  /* La perforation de la marge : son pas, son diamètre et son encre. Elle est du thème et
   * non de la feuille — remplacer l'identité doit suffire à la faire disparaître. */
  --perforation-pas: 1.5rem;
  --perforation-rayon: 0.2rem;
  --perforation-encre: var(--color-accent);

  @keyframes impression {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
}

@layer components {
  /* La marge perforée du papier en continu, tracée par la feuille plutôt que par une
   * image — un fragment n'en livrerait aucune. Un seul motif, deux emplois : la feuille
   * le porte sur ses deux bords, la marge d'un rail sur un seul. Ni l'une ni l'autre ne
   * connaît sa géométrie, qui est au thème — remplacer celui-ci les efface ensemble. */
  .feuille,
  .marge {
    --trou: radial-gradient(
      circle at calc(var(--perforation-pas) / 2) calc(var(--perforation-pas) / 2),
      var(--perforation-encre) var(--perforation-rayon),
      transparent calc(var(--perforation-rayon) + 1px)
    );
    --bande-de-trous: var(--perforation-pas) var(--perforation-pas) repeat-y;
  }

  .feuille {
    background:
      var(--trou) left top / var(--bande-de-trous),
      var(--trou) right top / var(--bande-de-trous);
  }

  /* Large d'un pas, pour que le trou tombe en son milieu comme sur la feuille. */
  .marge {
    width: var(--perforation-pas);
    background: var(--trou) left top / var(--bande-de-trous);
  }
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  body {
    margin: 0;
    color-scheme: light;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
  }
}

/* Les composants animent leur entrée pour dire d'où elles viennent — un panneau glisse du
 * bord qu'il occupe. Qui a demandé moins de mouvement obtient le même état final, posé
 * sans trajet. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
