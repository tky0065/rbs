<script setup lang="ts">
import { onMounted, ref } from 'vue'
import { RouterLink } from 'vue-router'

import Bande from '@/components/Bande.vue'

/** Le nom du projet, tel que `rbs new` l'a fixé. */
const PROJET = '{@ project_name @}'

{% if lang == "en" -%}
const TITRE = 'The client is in place'
const SOUS_TITRE =
  'The base serves this page and a gallery of its interface components, and nothing else. It asks the service, and nothing it shows is written in advance.'
const ETAT = 'Health probe'
const COMPOSANTS = 'Interface components'
const GALERIE = 'See the gallery'
const LIBELLE = {
  attente: 'asking…',
  ok: 'answering',
  degradee: 'degraded',
  injoignable: 'unreachable',
} as const
{% else -%}
const TITRE = 'Le client est en place'
const SOUS_TITRE =
  "Le socle sert cette page et une galerie de ses composants d'interface, et rien d'autre. Elle interroge le service, et rien de ce qu'elle affiche n'est écrit d'avance."
const ETAT = 'Sonde de santé'
const COMPOSANTS = "Composants d'interface"
const GALERIE = 'Voir la galerie'
const LIBELLE = {
  attente: 'interrogation…',
  ok: 'répond',
  degradee: 'dégradée',
  injoignable: 'injoignable',
} as const
{% endif %}
type Etat = keyof typeof LIBELLE

const etat = ref<Etat>('attente')

// Interrogée réellement : la page ne dit de l'API que ce qu'elle vient d'en obtenir. En
// développement, l'appel passe par le relais déclaré dans la configuration de build ; une
// fois construit, il part vers le binaire qui sert cette page.
onMounted(async () => {
  try {
    const reponse = await fetch('/health')
    etat.value = reponse.ok ? 'ok' : 'degradee'
  } catch {
    etat.value = 'injoignable'
  }
})
</script>

<template>
  <main class="mx-auto max-w-4xl border-x border-border">
    <Bande>
      <p class="mb-6 uppercase tracking-[0.35em] text-muted-foreground">{{ PROJET }}</p>
      <h1 class="mb-4 text-3xl leading-tight">{{ TITRE }}</h1>
      <p class="text-muted-foreground">{{ SOUS_TITRE }}</p>
    </Bande>

    <Bande :titre="ETAT">
      <dl class="grid grid-cols-[minmax(10rem,auto)_1fr] gap-x-6 gap-y-1">
        <dt class="text-muted-foreground">
          <code class="border border-border bg-background px-1.5 py-0.5">/health</code>
        </dt>
        <dd :class="etat === 'ok' ? '' : 'text-destructive'">{{ LIBELLE[etat] }}</dd>
      </dl>
    </Bande>

    <Bande :titre="COMPOSANTS">
      <RouterLink to="/galerie" class="underline underline-offset-4">{{ GALERIE }}</RouterLink>
    </Bande>
  </main>
</template>
