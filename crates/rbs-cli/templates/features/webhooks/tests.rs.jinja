#[test]
fn private_loopback_and_link_local_addresses_are_not_public() {
    for adresse in [
        "127.0.0.1",
        "10.0.0.5",
        "172.16.3.4",
        "172.31.255.255",
        "192.168.1.1",
        "169.254.169.254",
        "100.64.0.1",
        "0.0.0.0",
        "224.0.0.1",
        "::1",
        "::",
        "fc00::1",
        "fd12::1",
        "fe80::1",
        "::ffff:10.0.0.1",
        "ff02::1",
        "64:ff9b::a00:5",
        "::7f00:1",
        "2002:a00:5::",
        "2001:0:4136:e378:8000:63bf:3fff:fdd2",
        "fec0::1",
        "0.0.0.1",
        "240.0.0.1",
        "192.0.0.9",
        "198.18.0.1",
        "192.88.99.1",
    ] {
        let ip: IpAddr = adresse.parse().expect("adresse lisible");
        assert!(!is_public(ip), "{adresse} devrait être refusée");
    }
}

#[test]
fn public_addresses_are_public() {
    for adresse in [
        "93.184.216.34",
