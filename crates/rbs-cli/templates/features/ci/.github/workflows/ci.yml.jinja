name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always
  # Les tests montent l'application sur une vraie base, et `.env` n'est pas versionné :
  # l'URL vient d'ici, comme elle viendrait de l'environnement en production.
  RBS_DATABASE__URL: {@ database_url_par_defaut @}

jobs:
  ci:
    name: fmt · clippy · test
    runs-on: ubuntu-latest
{%- if database_a_un_serveur %}

    services:
{%- if database == "postgres" %}
      postgres:
        image: postgres:18
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: {@ crate_name @}
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
{%- else %}
      mysql:
        image: mysql:8
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: {@ crate_name @}
        ports:
          - 3306:3306
        options: >-
          --health-cmd "mysqladmin ping -h 127.0.0.1 -uroot -proot"
{%- endif %}
          --health-interval 2s
          --health-timeout 3s
          --health-retries 30
{%- endif %}

    # Chaque action est épinglée par SHA, sa version en commentaire : un tag peut être
    # déplacé vers un autre commit, un SHA non. `.github/dependabot.yml` en propose les
    # montées.
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      # L'action déduit la toolchain du nom de sa référence, qu'un SHA ne porte pas.
      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable
        with:
          toolchain: stable
          components: rustfmt, clippy

      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2

      - name: cargo fmt
        run: cargo fmt --all --check

      - name: cargo clippy
        run: cargo clippy --workspace --all-targets -- -D warnings

      # Les tests d'une feature générée supposent le schéma en place : sans cette étape,
      # ils échouent sur une table absente, loin de la cause.
      - name: migrations
        run: cargo run -p migration -- up

      # Les tests qui joignent la base sont `#[ignore]` pour qu'un `cargo test` reste
      # rapide sur le poste ; ici la base est montée et migrée, donc on les inclut — sans
      # quoi la CI passe verte sans avoir exercé un seul CRUD. `--no-fail-fast` : un
      # binaire de test rouge ne doit pas masquer ceux qui le suivent.
      - name: cargo test
        run: cargo test --workspace --no-fail-fast -- --include-ignored
