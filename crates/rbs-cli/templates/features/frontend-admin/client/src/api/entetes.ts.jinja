/**
 * L'en-tête d'autorisation, posé par-dessus le client d'API du socle.
 *
 * Le socle instancie le client et appelle son API sans jeton ; le shell d'administration
 * n'ajoute que ceci. Le module est découvert par `src/api/index.ts` comme un montage
 * l'est par le routeur — un fragment ne peut pas redéposer un fichier qu'un autre a
 * posé, et la découverte est la voie que le socle ouvre à ses fragments.
 */
import { jetonAcces } from './jetons'

export function entetes(): Record<string, string> {
  const jeton = jetonAcces()

  return jeton === null ? {} : { authorization: `Bearer ${jeton}` }
}
