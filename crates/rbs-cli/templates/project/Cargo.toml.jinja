[workspace]
members = ["migration"]
resolver = "3"

[package]
name = "{@ project_name @}"
version = "0.1.0"
edition = "2024"
# Le paquet porte deux binaires : sans ce choix, `cargo run` ne saurait plus lequel lancer.
default-run = "{@ project_name @}"

[package.metadata.rbs]
version = "{@ rbs_version @}"
features = ["health"]
database = "{@ database @}"

[[bin]]
name = "{@ project_name @}"
path = "src/main.rs"

[[bin]]
name = "seed"
path = "src/seeds/main.rs"

[dependencies]
rbs-core = {@ rbs_core_dep @}
anyhow = "1.0"
axum = "0.8"
chrono = "0.4"
sea-orm = { version = "2.0", features = ["{@ sea_orm_feature @}", "runtime-tokio-rustls", "macros", "with-chrono", "with-uuid"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.53", features = ["macros", "rt-multi-thread"] }
tracing = "0.1"
utoipa = { version = "5.5", features = ["axum_extras", "chrono", "uuid"] }
utoipa-swagger-ui = { version = "9.0", features = ["axum"] }
validator = { version = "0.21", features = ["derive"] }

[dev-dependencies]
tower = { version = "0.5", features = ["util"] }
# sea-orm expose bien `Uuid`, mais sans son générateur : `new_v4` demande la feature `v4`,
# dont le noyau n'a pas l'usage.
uuid = { version = "1.25", features = ["v4"] }
