RBS_ENV=development
RBS_DATABASE__URL={@ database_url_par_defaut @}
{%- if compose %}

# Le service `db` de docker-compose.yml interpole ces clés depuis `.env`, qui n'est pas
# versionné : ce sont les identifiants de l'URL ci-dessus, à remplacer par les vôtres.
{%- if database == "postgres" %}
POSTGRES_USER={@ database_user_par_defaut @}
POSTGRES_PASSWORD={@ database_password_par_defaut @}
POSTGRES_DB={@ database_name_par_defaut @}
{%- else %}
MYSQL_ROOT_PASSWORD={@ database_password_par_defaut @}
MYSQL_DATABASE={@ database_name_par_defaut @}
{%- if database_user_par_defaut != "root" %}
MYSQL_USER={@ database_user_par_defaut @}
MYSQL_PASSWORD={@ database_password_par_defaut @}
{%- endif %}
{%- endif %}
{%- endif %}

RBS_LOG_FORMAT=pretty
RUST_LOG=info,{@ crate_name @}=debug
