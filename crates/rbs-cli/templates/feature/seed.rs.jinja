//! Données de démonstration de `{@ module @}`.

use sea_orm::ActiveValue::Set;
{%- if uuid %}
use sea_orm::prelude::Uuid;
{%- endif %}
use sea_orm::{ActiveModelTrait, DatabaseConnection, DbErr};

// Le binaire des seeds est une racine de crate distincte de celle de l'application : il
// rejoint l'entité par son chemin, et n'en appelle qu'une part.
#[path = "../{@ module @}/model.rs"]
mod model;

/// Insère les {@ module @} de démonstration.
pub async fn seed(db: &DatabaseConnection) -> Result<(), DbErr> {
    // `id`, `created_at` et `updated_at` tiennent leur valeur du défaut de la colonne.
{%- for ligne in lignes %}
    model::ActiveModel {
{%- for field in ligne %}
        {@ field.name @}: Set({@ field.value @}),
{%- endfor %}
        ..Default::default()
    }
    .insert(db)
    .await?;
{% endfor %}
    Ok(())
}
