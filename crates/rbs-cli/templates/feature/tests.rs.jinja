/// Sans jeton, l'écriture est refusée avant même que le corps ne soit lu.
#[tokio::test]
async fn an_anonymous_write_returns_401() {
    let api = application().await;
    let anonyme = Request::builder()
        .method("POST")
        .uri("/{@ module @}")
        .header("content-type", "application/json")
        .body(Body::from("{}"))
        .expect("requête bien formée");

    let (status, body) = call(&api, anonyme).await;

    assert_eq!(status, StatusCode::UNAUTHORIZED);
    assert_eq!(body["status"], 401, "{body}");
}
