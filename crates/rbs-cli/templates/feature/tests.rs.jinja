/// Compare à la réponse la valeur envoyée pour `champ`.
fn compare(rendered: &Value, sent: &Value, champ: &str) {
    assert_eq!(rendered[champ], sent[champ], "« {champ} » mal rendu");
}
{% endif %}
{%- if timestamped %}
/// Vérifie que `champ` est rendu, sans comparer sa valeur.
///
/// Les horodatages passent par ici : PostgreSQL les rend dans son propre format, qui
/// n'est pas celui de la chaîne envoyée.
fn filled(rendered: &Value, champ: &str) {
    assert!(
        !rendered[champ].is_null(),
        "« {champ} » absent de la réponse"
    );
}
