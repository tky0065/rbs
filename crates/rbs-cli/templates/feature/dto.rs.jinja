{#
  `DateTimeWithTimeZone` est un alias : utoipa reconnaît les types chrono par leur nom
  écrit — `DateTime`, `NaiveDateTime` — et bute donc sur celui-ci. Le format se déclare
  à la main plutôt que par un import renommé, qui casserait sans bruit à la première
  retouche de l'utilisateur.

  `Decimal` passe par le même chemin, pour une autre raison : le document doit dire une
  chaîne, qui est ce que le corps porte. Un nombre y passerait par le flottant d'un client
  JavaScript, qui perdrait les centimes.
-#}
{% macro schema_format(field, optional) -%}
{% if field.type == "datetime" %}
    #[schema(value_type = {@ "Option<String>" if optional else "String" @}, format = DateTime)]
{%- elif field.type == "decimal" %}
    #[schema(value_type = {@ "Option<String>" if optional else "String" @}, format = "decimal")]
{%- endif %}
{%- endmacro -%}
{% macro body(fields, all_optional) -%}
{% if fields %} {
{%- for field in fields %}
{@- schema_format(field, all_optional or field.optional) @}
{%- if field.validations %}
    #[validate({@ field.validations | join(", ") @})]
{%- endif %}
    pub {@ field.name @}: {@ "Option<" ~ field.bare_rust_type ~ ">" if all_optional else field.rust_type @},
{%- endfor %}
}
{%- else %} {}
{%- endif %}
{%- endmacro -%}
{% if has_date %}use sea_orm::prelude::Date;
{% endif -%}
{% if has_decimal %}use sea_orm::prelude::Decimal;
{% endif -%}
use sea_orm::prelude::{DateTimeWithTimeZone, Uuid};
use serde::{Deserialize, Serialize};
use utoipa::ToSchema;
use validator::Validate;

use super::model::{@ model_import @};

#[derive(Debug, Deserialize, ToSchema, Validate)]
pub struct Create{@ entity @}{@ body(fields, false) @}

#[derive(Debug, Deserialize, ToSchema, Validate)]
pub struct Update{@ entity @}{@ body(fields, true) @}

#[derive(Debug, Serialize, ToSchema)]
pub struct {@ entity @}Response {
    pub id: Uuid,
{%- for field in fields %}
{@- schema_format(field, field.optional) @}
    pub {@ field.name @}: {@ field.rust_type @},
{%- endfor %}
    #[schema(value_type = String, format = DateTime)]
    pub created_at: DateTimeWithTimeZone,
    #[schema(value_type = String, format = DateTime)]
    pub updated_at: DateTimeWithTimeZone,
}

impl From<Model> for {@ entity @}Response {
    fn from(model: Model) -> Self {
        Self {
            id: model.id,
{%- for field in fields %}
{#- Les cent colonnes de `max_width` : la ligne porte le nom du champ deux fois, et
    rustfmt casse alors l'accès plutôt que l'affectation. #}
{%- set affectation = "            " ~ field.name ~ ": model." ~ field.name ~ "," %}
{%- if affectation | length <= 100 %}
{@ affectation @}
{%- else %}
            {@ field.name @}: model
                .{@ field.name @},
{%- endif %}
{%- endfor %}
            created_at: model.created_at,
            updated_at: model.updated_at,
        }
    }
}
