{% set dto = ["Create" ~ entity, entity ~ "Response", "Update" ~ entity] | sort -%}
use rbs_core::{Error, Page, Pagination, Result};
use sea_orm::ActiveValue::Set;
use sea_orm::DatabaseConnection;
use sea_orm::prelude::Uuid;

use super::dto::{{@ dto | join(", ") @}};
use super::repository::{self, ActiveModel};

pub async fn list(
    db: &DatabaseConnection,
    pagination: &Pagination,
) -> Result<Page<{@ entity @}Response>> {
    let ({@ module @}, total) = repository::list(db, pagination).await?;

    Ok(Page::new(
        {@ module @}.into_iter().map(Into::into).collect(),
        pagination,
        total,
    ))
}

pub async fn find(db: &DatabaseConnection, id: Uuid) -> Result<{@ entity @}Response> {
    let {@ singular @} = repository::find(db, id)
        .await?
        .ok_or(Error::NotFound("{@ singular @}"))?;

    Ok({@ singular @}.into())
}

pub async fn create(db: &DatabaseConnection, input: Create{@ entity @}) -> Result<{@ entity @}Response> {
    let {@ singular @} = ActiveModel {
{%- for field in fields %}
        {@ field.name @}: Set(input.{@ field.name @}),
{%- endfor %}
        ..Default::default()
    };

    Ok(repository::create(db, {@ singular @}).await?.into())
}

pub async fn update(
    db: &DatabaseConnection,
    id: Uuid,
    input: Update{@ entity @},
) -> Result<{@ entity @}Response> {
    let mut {@ singular @}: ActiveModel = repository::find(db, id)
        .await?
        .ok_or(Error::NotFound("{@ singular @}"))?
        .into();

    // Un champ absent du corps garde sa valeur : cette route ne peut donc pas remettre un
    // champ optionnel à NULL. Ajoutez-y le cas si votre API en a besoin.
{%- for field in fields %}
    if let Some({@ field.name @}) = input.{@ field.name @} {
        {@ singular @}.{@ field.name @} = Set({@ ("Some(" ~ field.name ~ ")") if field.optional else field.name @});
    }
{%- endfor %}
    {@ singular @}.updated_at = Set(chrono::Utc::now().into());

    Ok(repository::update(db, {@ singular @}).await?.into())
}

pub async fn delete(db: &DatabaseConnection, id: Uuid) -> Result<()> {
    if !repository::delete(db, id).await? {
        return Err(Error::NotFound("{@ singular @}"));
    }

    Ok(())
}
