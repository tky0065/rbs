{% set dto = ["Create" ~ entite, entite ~ "Response", "Update" ~ entite] | sort -%}
use rbs_core::{Error, Page, Pagination, Result};
use sea_orm::ActiveValue::Set;
use sea_orm::DatabaseConnection;
use sea_orm::prelude::Uuid;

use super::dto::{{@ dto | join(", ") @}};
use super::repository::{self, ActiveModel};

pub async fn list(
    db: &DatabaseConnection,
    pagination: &Pagination,
) -> Result<Page<{@ entite @}Response>> {
    let ({@ module @}, total) = repository::list(db, pagination).await?;

    Ok(Page::new(
        {@ module @}.into_iter().map(Into::into).collect(),
        pagination,
        total,
    ))
}

pub async fn find(db: &DatabaseConnection, id: Uuid) -> Result<{@ entite @}Response> {
    let {@ singulier @} = repository::find(db, id)
        .await?
        .ok_or(Error::NotFound("{@ singulier @}"))?;

    Ok({@ singulier @}.into())
}

pub async fn create(db: &DatabaseConnection, input: Create{@ entite @}) -> Result<{@ entite @}Response> {
    let {@ singulier @} = ActiveModel {
{%- for champ in champs %}
        {@ champ.nom @}: Set(input.{@ champ.nom @}),
{%- endfor %}
        ..Default::default()
    };

    Ok(repository::create(db, {@ singulier @}).await?.into())
}

pub async fn update(
    db: &DatabaseConnection,
    id: Uuid,
    input: Update{@ entite @},
) -> Result<{@ entite @}Response> {
    let mut {@ singulier @}: ActiveModel = repository::find(db, id)
        .await?
        .ok_or(Error::NotFound("{@ singulier @}"))?
        .into();

    // Un champ absent du corps garde sa valeur : cette route ne peut donc pas remettre un
    // champ optionnel à NULL. Ajoutez-y le cas si votre API en a besoin.
{%- for champ in champs %}
    if let Some({@ champ.nom @}) = input.{@ champ.nom @} {
        {@ singulier @}.{@ champ.nom @} = Set({@ ("Some(" ~ champ.nom ~ ")") if champ.optionnel else champ.nom @});
    }
{%- endfor %}
    {@ singulier @}.updated_at = Set(chrono::Utc::now().into());

    Ok(repository::update(db, {@ singulier @}).await?.into())
}

pub async fn delete(db: &DatabaseConnection, id: Uuid) -> Result<()> {
    if !repository::delete(db, id).await? {
        return Err(Error::NotFound("{@ singulier @}"));
    }

    Ok(())
}
