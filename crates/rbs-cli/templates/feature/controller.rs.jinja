{% if auth -%}
//! Toutes les routes exigent un jeton : `Identity` rend 401 sans jeton valide, et
//! `require_role` 403 en deçà du rôle nommé. Sur une route à durcir, montez le rôle ;
//! sur une route à ouvrir au public, retirez le paramètre `identite`, l'appel à
//! `require_role`, l'entrée `security` et les réponses 401 et 403 de son annotation.

{% endif -%}
{% set role_lecture = "User" -%}
{% set role_ecriture = role if role else "User" -%}
{% set dto = ["Create" ~ entity, entity ~ "Response", "Update" ~ entity] | sort -%}
use axum::Json;
{%- if with_upload %}
use axum::body::Bytes;
{%- endif %}
use axum::extract::{Path, State};
use axum::http::StatusCode;
{%- if with_upload %}
use axum::response::IntoResponse;
{%- endif %}
{#- `Cursor` et `CursorPage` allongent l'import au-delà des cent colonnes, sans rien qui suive
    le nom de l'entité : il s'écrit donc éclaté une fois pour toutes, comme rustfmt le
    répartit — `ValidatedJson` passe seul à la ligne dès qu'`Identity` s'y ajoute. #}
{%- if cursor and auth %}
use rbs_core::{
    Cursor, CursorPage, HasCoreState, Identity, Page, Pagination, ProblemDetails, Result,
    ValidatedJson,
};
{%- elif cursor %}
use rbs_core::{
    Cursor, CursorPage, HasCoreState, Page, Pagination, ProblemDetails, Result, ValidatedJson,
};
{%- elif auth %}
use rbs_core::{HasCoreState, Identity, Page, Pagination, ProblemDetails, Result, ValidatedJson};
{%- else %}
use rbs_core::{HasCoreState, Page, Pagination, ProblemDetails, Result, ValidatedJson};
{%- endif %}
use sea_orm::prelude::Uuid;

{# La ligne porte le nom de l'entité trois fois : dès dix-neuf caractères, elle franchit
    les 98 colonnes au-delà desquelles rustfmt éclate un `use` — deux en deçà de son
    `max_width`. La template l'écrit donc déjà éclatée, plutôt que de laisser la mise en
    forme rattraper ce qu'elle aurait mal posé. Dès vingt-quatre, rustfmt répartirait les
    trois noms sur plusieurs lignes intérieures : c'est là, et seulement là, que la mise
    en forme reprend la main. -#}
{% set import = "use super::dto::{" ~ (dto | join(", ")) ~ "};" -%}
{% if import | length <= 98 -%}
{@ import @}
{% else -%}
use super::dto::{
    {@ dto | join(", ") @},
};
{% endif -%}
use super::filter::{@ entity @}Filter;
use super::service;
{%- if auth %}
use crate::auth::guard::RequireRole;
use crate::auth::model::Role;
{%- endif %}
use crate::state::AppState;

#[utoipa::path(
    get,
    path = "/{@ module @}",
    tag = "{@ module @}",
    operation_id = "{@ module @}_list",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(
{%- if cursor %}
        ("after" = Option<Uuid>, Query, description = "identifiant après lequel reprendre ; absent, la première page"),
{%- else %}
        ("page" = Option<u64>, Query, description = "numéro de page, à partir de 1"),
{%- endif %}
        ("per_page" = Option<u64>, Query, description = "éléments par page, 100 au plus")
    ),
    responses(
{%- if cursor %}
        (status = 200, description = "page de {@ module @}", body = CursorPage<{@ entity @}Response>),
        (status = 400, description = "curseur ou pagination illisible", body = ProblemDetails, content_type = "application/problem+json")
{%- else %}
        (status = 200, description = "page de {@ module @}", body = Page<{@ entity @}Response>),
        (status = 400, description = "pagination illisible", body = ProblemDetails, content_type = "application/problem+json")
{%- endif %}
{%- if auth %},
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"){% endif %}
    )
)]
pub async fn list(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
{%- if cursor %}
    cursor: Cursor,
) -> Result<Json<CursorPage<{@ entity @}Response>>> {
{%- else %}
    pagination: Pagination,
) -> Result<Json<Page<{@ entity @}Response>>> {
{%- endif %}
{%- if auth %}
    identite.require_role(Role::{@ role_lecture @})?;
{% endif %}
{%- if cursor %}
    Ok(Json(service::list(state.core().db(), &cursor).await?))
{%- else %}
    Ok(Json(service::list(state.core().db(), &pagination).await?))
{%- endif %}
}

/// Filtrer est une lecture : le corps porte les conditions, que l'URL rendrait illisibles.
{%- if not auth %}
/// Le garde de rôle ne s'y applique donc pas, pas plus qu'à `list` ou `find`.
{%- endif %}
#[utoipa::path(
    post,
    path = "/{@ module @}/filter",
    tag = "{@ module @}",
    operation_id = "{@ module @}_filter",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(
        ("page" = Option<u64>, Query, description = "numéro de page, à partir de 1"),
        ("per_page" = Option<u64>, Query, description = "éléments par page, 100 au plus")
    ),
    request_body = {@ entity @}Filter,
    responses(
        (status = 200, description = "page de {@ module @} filtrés", body = Page<{@ entity @}Response>),
        (status = 400, description = "filtre, tri ou pagination illisible", body = ProblemDetails, content_type = "application/problem+json"){% if auth %},
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"){% endif %}
    )
)]
pub async fn filter(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    pagination: Pagination,
    Json(filtre): Json<{@ entity @}Filter>,
) -> Result<Json<Page<{@ entity @}Response>>> {
{%- if auth %}
    identite.require_role(Role::{@ role_lecture @})?;
{% endif %}
    Ok(Json(
        service::filter(state.core().db(), &filtre, &pagination).await?,
    ))
}

#[utoipa::path(
    post,
    path = "/{@ module @}",
    tag = "{@ module @}",
    operation_id = "{@ module @}_create",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    request_body = Create{@ entity @},
    responses(
        (status = 201, description = "{@ singular @} créé", body = {@ entity @}Response),
        (status = 400, description = "corps illisible", body = ProblemDetails, content_type = "application/problem+json"),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 409, description = "valeur déjà prise sur une colonne unique", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
pub async fn create(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    ValidatedJson(input): ValidatedJson<Create{@ entity @}>,
) -> Result<(StatusCode, Json<{@ entity @}Response>)> {
{%- if auth %}
    identite.require_role(Role::{@ role_ecriture @})?;
{% endif %}
    let {@ singular @} = service::create(state.core().db(), input).await?;

    Ok((StatusCode::CREATED, Json({@ singular @})))
}

#[utoipa::path(
    get,
    path = "/{@ module @}/{id}",
    tag = "{@ module @}",
    operation_id = "{@ module @}_find",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    responses(
        (status = 200, description = "{@ singular @} demandé", body = {@ entity @}Response),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "{@ singular @} introuvable", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
{#- Les cent colonnes de `max_width` : en deçà, rustfmt ramène la signature sur une ligne,
    ce qui n'arrive qu'aux entités d'une ou deux lettres. Sous `auth`, `identite` allonge
    la signature au point qu'elle ne tient plus jamais sur une ligne : la garde de
    longueur ne s'applique donc qu'en son absence. #}
{%- if auth %}
pub async fn find(
    State(state): State<AppState>,
    identite: Identity,
    Path(id): Path<Uuid>,
) -> Result<Json<{@ entity @}Response>> {
    identite.require_role(Role::{@ role_lecture @})?;
{% else %}
{%- set signature_find = "pub async fn find(State(state): State<AppState>, Path(id): Path<Uuid>) -> Result<Json<" ~ entity ~ "Response>> {" %}
{%- if signature_find | length <= 100 %}
{@ signature_find @}
{%- else %}
pub async fn find(
    State(state): State<AppState>,
    Path(id): Path<Uuid>,
) -> Result<Json<{@ entity @}Response>> {
{%- endif %}
{%- endif %}
    Ok(Json(service::find(state.core().db(), id).await?))
}

#[utoipa::path(
    patch,
    path = "/{@ module @}/{id}",
    tag = "{@ module @}",
    operation_id = "{@ module @}_update",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    request_body = Update{@ entity @},
    responses(
        (status = 200, description = "{@ singular @} mis à jour", body = {@ entity @}Response),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "{@ singular @} introuvable", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 409, description = "valeur déjà prise sur une colonne unique", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
pub async fn update(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    Path(id): Path<Uuid>,
    ValidatedJson(input): ValidatedJson<Update{@ entity @}>,
) -> Result<Json<{@ entity @}Response>> {
{%- if auth %}
    identite.require_role(Role::{@ role_ecriture @})?;
{% endif %}
    Ok(Json(service::update(state.core().db(), id, input).await?))
}

#[utoipa::path(
    delete,
    path = "/{@ module @}/{id}",
    tag = "{@ module @}",
    operation_id = "{@ module @}_delete",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    responses(
        (status = 204, description = "{@ singular @} supprimé"),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "{@ singular @} introuvable", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
{% if auth -%}
pub async fn delete(
    State(state): State<AppState>,
    identite: Identity,
    Path(id): Path<Uuid>,
) -> Result<StatusCode> {
    identite.require_role(Role::{@ role_ecriture @})?;
{% else -%}
pub async fn delete(State(state): State<AppState>, Path(id): Path<Uuid>) -> Result<StatusCode> {
{%- endif %}
{%- if with_upload and not soft_delete %}
    service::delete(state.core().db(), state.storage().as_ref(), id).await?;
{%- else %}
    service::delete(state.core().db(), id).await?;
{%- endif %}

    Ok(StatusCode::NO_CONTENT)
}
{%- if with_upload %}

// Le contenu voyage hors du DTO : un corps binaire n'a pas sa place dans un JSON, et le
// faire passer en base64 obligerait à charger deux fois le fichier en mémoire.
#[utoipa::path(
    put,
    path = "/{@ module @}/{id}/content",
    tag = "{@ module @}",
    operation_id = "{@ module @}_put_content",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    request_body(content = String, content_type = "application/octet-stream"),
    responses(
        (status = 204, description = "contenu déposé"),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "{@ singular @} introuvable", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
pub async fn put_content(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    Path(id): Path<Uuid>,
    content: Bytes,
) -> Result<StatusCode> {
{%- if auth %}
    identite.require_role(Role::{@ role_ecriture @})?;
{% endif %}
    service::put_content(
        state.core().db(),
        state.storage().as_ref(),
        id,
        content.to_vec(),
    )
    .await?;

    Ok(StatusCode::NO_CONTENT)
}

#[utoipa::path(
    get,
    path = "/{@ module @}/{id}/content",
    tag = "{@ module @}",
    operation_id = "{@ module @}_get_content",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    responses(
        (status = 200, description = "contenu du {@ singular @}", content_type = "application/octet-stream"),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "contenu introuvable", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
pub async fn get_content(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    Path(id): Path<Uuid>,
) -> Result<impl IntoResponse> {
{%- if auth %}
    identite.require_role(Role::{@ role_lecture @})?;
{% endif %}
    let content = service::get_content(state.storage().as_ref(), id).await?;

    Ok(([("content-type", "application/octet-stream")], content))
}

#[utoipa::path(
    head,
    path = "/{@ module @}/{id}/content",
    tag = "{@ module @}",
    operation_id = "{@ module @}_head_content",
{%- if auth %}
    security(("bearer" = [])),
{%- endif %}
    params(("id" = Uuid, Path, description = "identifiant de {@ singular @}")),
    responses(
        (status = 204, description = "un contenu est déposé"),
{%- if auth %}
        (status = 401, description = "jeton absent ou invalide", body = ProblemDetails, content_type = "application/problem+json"),
        (status = 403, description = "rôle insuffisant", body = ProblemDetails, content_type = "application/problem+json"),
{%- endif %}
        (status = 404, description = "aucun contenu", body = ProblemDetails, content_type = "application/problem+json")
    )
)]
pub async fn head_content(
    State(state): State<AppState>,
{%- if auth %}
    identite: Identity,
{%- endif %}
    Path(id): Path<Uuid>,
) -> Result<StatusCode> {
{%- if auth %}
    identite.require_role(Role::{@ role_lecture @})?;
{% endif %}
    if service::has_content(state.storage().as_ref(), id).await? {
        Ok(StatusCode::NO_CONTENT)
    } else {
{%- if lang == "en" %}
        Err(rbs_core::Error::NotFound("content"))
{%- else %}
        Err(rbs_core::Error::NotFound("contenu"))
{%- endif %}
    }
}
{%- endif %}
