use sea_orm::ActiveValue::Set;
use sea_orm::entity::prelude::*;
{%- if enum_types %}
use serde::{Deserialize, Serialize};
use utoipa::ToSchema;
{%- endif %}
{%- for field in fields if field.enum_variants %}

/// Valeurs acceptées par la colonne « {@ field.name @} ».
///
/// Une valeur de plus s'ajoute ici, et dans le `CHECK` que porte la migration : la base
/// refuse celles qu'elle ne connaît pas, et seule une migration nouvelle l'élargit.
{#- La ligne des dérives passe les cent colonnes de `max_width` : rustfmt l'éclate, et le
    gabarit l'écrit déjà éclatée. Elle ne dépend d'aucun nom — ni celui de la feature, ni
    celui du champ — et ne bascule donc jamais. #}
#[derive(
    Clone, Copy, Debug, PartialEq, Eq, EnumIter, DeriveActiveEnum, Deserialize, Serialize, ToSchema,
)]
#[sea_orm(rs_type = "String", db_type = "String(StringLen::N({@ field.enum_length @}))")]
pub enum {@ field.enum_type @} {
{%- for case in field.enum_cases %}
    #[sea_orm(string_value = "{@ case.value @}")]
    #[serde(rename = "{@ case.value @}")]
    {@ case.variant @},
{%- endfor %}
}
{%- endfor %}

#[derive(Clone, Debug, PartialEq, DeriveEntityModel)]
#[sea_orm(table_name = "{@ table @}")]
pub struct Model {
    #[sea_orm(primary_key, auto_increment = false)]
    pub id: Uuid,
{#- Un champ ne porte jamais deux de ces attributs : `column_type` ne sort que sur
    `text`, qui refuse `unique` comme `index` ; sur les autres scalaires, cumuler les
    deux est refusé comme redondant ; et une référence n'indexe que ce qu'`unique`
    n'indexe pas déjà. -#}
{%- for field in fields %}
{%- if field.column_type_attribute %}
    #[sea_orm(column_type = "{@ field.column_type_attribute @}")]
{#- Sous suppression logique, l'unicité a quitté la colonne pour un index restreint aux
    lignes vivantes : la laisser ici ferait décrire à l'entité un schéma que la base n'a
    pas. Elle ne construit rien à l'exécution, elle se lit — et elle mentirait. #}
{%- elif field.unique and not soft_delete %}
    #[sea_orm(unique)]
{%- elif field.index %}
    #[sea_orm(indexed)]
{%- endif %}
    pub {@ field.name @}: {@ field.rust_type @},
{%- endfor %}
    pub created_at: DateTimeWithTimeZone,
    pub updated_at: DateTimeWithTimeZone,
{%- if soft_delete %}
    // Nulle tant que la ligne vit. Le repository la remplit au lieu de retirer la ligne,
    // et écarte de toute lecture celles qui la portent.
    pub deleted_at: Option<DateTimeWithTimeZone>,
{%- endif %}
}

#[derive(Copy, Clone, Debug, EnumIter, DeriveRelation)]
pub enum Relation {
{%- for field in fields if field.relation %}
    #[sea_orm(
        belongs_to = "{@ field.relation.entity_path @}",
        from = "Column::{@ field.pascal_name @}",
        to = "{@ field.relation.target_column_path @}",
        on_delete = "{@ field.relation.on_delete @}"
    )]
    {@ field.relation.variant @},
{%- endfor %}
    // <rbs:relations:{@ table @}>
    // </rbs:relations:{@ table @}>
}
{%- for relation in unique_relations %}

impl Related<{@ relation.entity_path @}> for Entity {
    fn to() -> RelationDef {
        Relation::{@ relation.variant @}.def()
    }
}
{%- endfor %}
{%- for ambiguous in ambiguous_targets %}

{@ ambiguous.comment @}
{%- endfor %}

// <rbs:related:{@ table @}>
// </rbs:related:{@ table @}>

/// L'identifiant est posé ici, et non par un défaut de colonne : `uuidv7()` n'a
/// d'équivalent à écrire ni en MySQL ni en SQLite.
///
/// `new()` est le seul point à écrire — la macro fait déléguer `Default::default()` ici,
/// et tout ce que le projet insère passe par `..Default::default()`. La monotonie est
/// garantie par processus, là où celle de PostgreSQL l'était par serveur.
impl ActiveModelBehavior for ActiveModel {
    fn new() -> Self {
        Self {
            id: Set(Uuid::now_v7()),
            ..ActiveModelTrait::default()
        }
    }
}
